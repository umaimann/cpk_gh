<script>
(function () {
  var HOST = '<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"><style>html,body{margin:0;height:100%;background:#000;overflow:hidden}iframe{position:fixed;inset:0;width:100%;height:100%;border:0}</style></head><body><iframe id="cpk" name="cpk-frame" allow="autoplay; fullscreen; encrypted-media; picture-in-picture"></iframe><script>window.addEventListener("message",function(e){var d=e.data;if(d&&d.cpk==="go"&&typeof d.html==="string"){document.getElementById("cpk").srcdoc=d.html;}});<\/script></body></html>';
  function show(html) {
    if (window.name === 'cpk-frame') { parent.postMessage({ cpk: 'go', html: html }, '*'); return; }
    document.open();
    document.write(HOST);
    document.close();
    document.getElementById('cpk').srcdoc = html;
  }
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('.news__btListLink');
    if (!a) return;
    e.preventDefault();
    e.stopPropagation();
    if (a.classList.contains('is-active')) return;
    var url = a.href;
    fetch(url, { cache: 'no-cache' })
      .then(function (res) { if (!res.ok) throw new Error(res.status); return res.text(); })
      .then(show)
      .catch(function (err) { console.error('ページの取得に失敗:', err); location.href = url; });
  }, true);
})();
</script>
<script>
(function () {
  var RELAY = 'https://umaimann.github.io/cpk_gh/site/youtube.html';
  var EMBED = /youtube(?:-nocookie)?\.com\/embed\/([\w-]{6,})/;
  function fix(modal) {
    var f = modal.querySelector('iframe');
    if (!f) return;
    var s = f.getAttribute('src') || '';
    var m = s.match(EMBED);
    if (m && s.indexOf(RELAY) !== 0) {
      f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      f.setAttribute('src', RELAY + '?v=' + m[1]);
    }
  }
  function start() {
    var modal = document.getElementById('movieModal');
    if (!modal) return;
    new MutationObserver(function () { fix(modal); }).observe(modal, { subtree: true, childList: true, attributes: true, attributeFilter: ['src'] });
    fix(modal);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>
